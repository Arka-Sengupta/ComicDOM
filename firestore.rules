rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read blogs; only the admin UID can write
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "ADMIN_UID";
    }
    // Anyone can read comments; logged-in users can write them
    match /blogs/{blogId}/comments/{commentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
